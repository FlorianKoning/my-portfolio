---
import Section from "../components/layout/Section.astro";
import Hero from "../components/sections/Hero.astro";
import BaseLayout from "../layout/BaseLayout.astro";
---

<BaseLayout title="Florian Koning | Developer">
    <Section id="home" variant="glow" width="full">
        <Hero />
    </Section>

    <Section id="about">
        <h2 class="text-3xl text-accent">Over mij</h2>
    </Section>

    <Section id="projects">
        <h2 class="text-3xl text-accent">Projecten</h2>
    </Section>

    <Section id="contact">
        <h2 class="text-3xl text-accent">Contact</h2>
    </Section>
</BaseLayout>
