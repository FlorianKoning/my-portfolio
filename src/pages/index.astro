---
import { navItems } from "../data/site";
import BaseLayout from "../layout/BaseLayout.astro";
---

<BaseLayout title="Florian Koning | Developer">
    {
        navItems.map((item) => (
            <section
                id="{item.id}"
                class="min-h-svh pt-nav even:bg-ink-800"
            >
                <h2 class="p-8 text-3xl text-accent">{item.label}</h2>
            </section>
        ))
    }
</BaseLayout>
