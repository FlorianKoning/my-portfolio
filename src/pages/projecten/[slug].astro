---
import ProjectArticle from "../../components/project/ProjectArticle.astro";
import Lightbox from "../../components/ui/Lightbox.astro";
import { projects } from "../../data/projects";
import BaseLayout from "../../layout/BaseLayout.astro";

// [slug] in de bestandsnaam = deze ene file maakt meerdere pagina's.
// Astro vraagt hier tijdens het bouwen: welke pagina's zijn dat?
export function getStaticPaths() {
    return projects.map((project, index) => ({
        params: { slug: project.slug }, // → /projecten/dbm-militaria
        props: { project, index }, // → komt hieronder binnen als Astro.props
    }));
}

const { project, index } = Astro.props;

// Vorige/volgende lopen rond: na de laatste komt weer de eerste
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];

const counter = {
    current: String(index + 1).padStart(2, "0"),
    total: String(projects.length).padStart(2, "0"),
};

// De intro staat in template strings met enters erin; voor de <meta> één nette regel
const description = project.intro[0].replace(/\s+/g, " ").trim();
---

<BaseLayout
    title={`${project.title} | Florian Koning`}
    description={description}
>
    <div class="mx-auto max-w-7xl px-6 pt-nav lg:px-8">

        {/* Terug-link en teller. Mobiel: balk die onder de navbar blijft plakken.
            md: gewone regel boven het artikel (md:mt-14 + de md:pt-14 hieronder
            geven dezelfde ruimte als toen hij nog in de kolom stond). */}
        <div
            class="sticky top-nav z-40 -mx-6 flex items-center justify-between border-b border-ink-600 bg-ink-750 py-1 pr-6 pl-3 md:static md:z-auto md:mx-0 md:mt-14 md:border-b-0 md:bg-transparent md:p-0"
        >
            <a
                href="/#projects"
                class="inline-flex min-h-11 items-center px-3 text-xs text-accent transition-opacity hover:opacity-75 md:px-0 md:text-sm"
                >{"← Projecten Overzicht"}</a
            >
            <span class="text-xs text-text-dim md:font-terminal md:text-sm">
                <span class="hidden md:inline">{"// project "}</span><span
                    class="text-accent md:text-inherit">{counter.current}</span
                > / {counter.total}
            </span>
        </div>

        <div
            class="flex flex-col gap-10 pt-8 pb-16 md:gap-14 md:pt-14 md:pb-24"
        >
            <ProjectArticle project={project} />

            {
                /* Gewone links: terugknop, nieuw tabblad en delen werken vanzelf */
            }
            {
                projects.length > 1 && (
                    <nav
                        aria-label="Andere projecten"
                        class="grid grid-cols-2 gap-3 border-t border-dashed border-ink-500 pt-5 md:gap-6"
                    >
                        <a
                            href={`/projecten/${prev.slug}`}
                            rel="prev"
                            class="group flex min-w-0 flex-col gap-1"
                        >
                            <span class="text-xs text-text-dim md:text-sm">
                                vorige
                            </span>
                            <span class="truncate text-sm transition-colors group-hover:text-accent md:text-lg">
                                <span class="text-accent">←</span> {prev.title}
                            </span>
                        </a>
                        <a
                            href={`/projecten/${next.slug}`}
                            rel="next"
                            class="group flex min-w-0 flex-col items-end gap-1 text-right"
                        >
                            <span class="text-xs text-text-dim md:text-sm">
                                volgende
                            </span>
                            <span class="max-w-full truncate text-sm transition-colors group-hover:text-accent md:text-lg">
                                {next.title} <span class="text-accent">→</span>
                            </span>
                        </a>
                    </nav>
                )
            }
        </div>
    </div>

    <Lightbox />
</BaseLayout>
