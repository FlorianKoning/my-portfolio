---
import { Image } from "astro:assets";
import portrait from "../../assets/florian-portrait.jpeg";
import { about, aboutFacts } from "../../data/about";
import CodeLabel from "../ui/CodeLabel.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tile from "../ui/Tile.astro";

type Fact = { id: string; label: string; text: string | number };

// Getallen krijgen een grote tegel, tekst een rij in de lijst
const facts: Fact[] = aboutFacts;
const numberFacts = facts.filter((f) => typeof f.text === "number");
const textFacts = facts.filter((f) => typeof f.text !== "number");
---

<div class="flex flex-col gap-5.5 md:gap-8">
    <SectionHeading id="over-mij" title="Over" highlight="mij" />

    <!-- Onder lg zijn de twee kolommen `contents`: de wrapper doet dan niet mee
         in de layout, dus de blokken erin worden direct flex-items van deze div.
         Zo kan `order` ze herschikken: foto, voorstellen, weetjes, hoe het begon. -->
    <div class="flex flex-col gap-5.5 md:gap-6 lg:flex-row lg:items-stretch">
        <!-- Links: foto + drie getallen -->
        <div
            class="contents lg:flex lg:w-full lg:max-w-95 lg:shrink-0 lg:basis-[38%] lg:flex-col lg:gap-5"
        >
            <!-- Foto met verschoven kader -->
            <!-- Alleen inschuiven, geen float: een oneindige transform-animatie maakt tekst wazig -->
            <div
                class="reveal slide-in from-left relative order-1 pr-3.5 pb-3.5 md:pr-4.5 md:pb-4.5 lg:order-none"
            >
                <div
                    aria-hidden="true"
                    class="absolute inset-0 top-3.5 left-3.5 rounded-[0_2rem_0_2rem] border-2 border-accent md:top-4.5 md:left-4.5 md:rounded-[0_2.5rem_0_2.5rem]"
                >
                </div>
                <Image
                    src={portrait}
                    alt="Portret van Florian Koning"
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 380px, 100vw"
                    class="relative block h-85 w-full rounded-[0_2rem_0_2rem] object-cover object-[center_35%] md:h-105 md:rounded-[0_2.5rem_0_2.5rem] md:object-[center_40%]"
                />
            </div>

            <!-- Feitjes: getallen als tegels, tekst als lijst -->
            <div class="order-3 flex flex-col gap-3 lg:order-none">
                <Tile
                    class="reveal slide-in from-left px-5 py-1.5 [--enter-delay:150ms] md:px-4 md:py-1"
                >
                    <dl class="divide-y divide-ink-600">
                        {
                            textFacts.map((fact) => (
                                <div class="flex items-baseline justify-between gap-3 py-3.5 md:flex-col md:items-start md:justify-start md:gap-1 md:py-3">
                                    <dt class="shrink-0 font-terminal text-[0.6875rem] text-text-dim md:text-sm">
                                        {`// ${fact.label.toLowerCase()}`}
                                    </dt>
                                    <dd class="text-right text-[0.8125rem] font-bold wrap-break-word text-accent md:text-left md:text-base">
                                        {fact.text}
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                </Tile>
            </div>
        </div>

        <!-- Rechts: tekst-tegels -->
        <div class="contents lg:flex lg:min-w-0 lg:flex-1 lg:flex-col lg:gap-5">
            <Tile
                class="reveal slide-in from-right order-2 flex flex-1 flex-col justify-center gap-3.5 px-5 py-6 [--enter-delay:100ms] md:gap-4.5 md:p-9 lg:order-none"
            >
                <span class="font-terminal text-[0.6875rem] text-accent md:text-sm">{about.greeting}</span>
                <p class="max-w-155 text-[0.9375rem] leading-[1.7] text-text md:text-lg md:leading-relaxed">
                    {about.intro}
                </p>
                <p class="max-w-155 text-[0.8125rem] leading-[1.75] text-text-subtle md:text-base md:leading-relaxed">
                    {about.body}
                </p>
            </Tile>

            <Tile
                class="reveal slide-in from-right order-4 flex flex-col gap-2.5 px-5 py-5.5 [--enter-delay:250ms] md:gap-3 md:px-9 md:py-7 lg:order-none"
            >
                <span class="font-terminal text-[0.6875rem] text-text-dim md:text-sm">
                    {about.origin.label}
                </span>
                <p
                    class="text-sm leading-[1.7] text-text-soft md:text-base md:leading-relaxed"
                >
                    {about.origin.text}
                </p>
            </Tile>
        </div>
    </div>

    <CodeLabel>{"</section>"}</CodeLabel>
</div>
