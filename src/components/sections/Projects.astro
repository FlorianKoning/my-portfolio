---
import { projects } from "../../data/projects";
import ProjectCard from "../project/ProjectCard.astro";
import CodeLabel from "../ui/CodeLabel.astro";
import SectionHeading from "../ui/SectionHeading.astro";

// Op de homepage alleen een overzicht; het hele verhaal staat op /projecten/[slug]
---

<div class="flex flex-col gap-10">
    <div class="flex flex-col gap-4">
        <SectionHeading id="projecten" title="Mijn" highlight="projecten" />
        <p
            class="max-w-180 text-base leading-relaxed text-text-subtle md:text-lg"
        >
            Een paar dingen die ik gebouwd heb. Klik op een project voor het
            hele verhaal: het idee, de keuzes en wat ik ervan leerde.
        </p>
    </div>

    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
            projects.map((project, index) => (
                <li>
                    <ProjectCard project={project} index={index} />
                </li>
            ))
        }
    </ul>

    <CodeLabel>{"</section>"}</CodeLabel>
</div>
