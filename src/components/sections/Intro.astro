---
import CodeLabel from "../ui/CodeLabel.astro";
import ProfileCard from "../ui/ProfileCard.astro";
import ScrollHint from "../ui/ScrollHint.astro";
import StatsCard from "../ui/StatsCard.astro";
---

<div
    class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-between"
>
    <!-- Kaarten schuiven in en blijven daarna zweven; elk eigen tempo zodat ze niet synchroon bewegen. Zie global.css. -->
    <ProfileCard
        class="slide-in-float from-left [--enter-delay:150ms] [--float-delay:-2s] [--float-duration:10s] [--float-r:0.6deg] [--float-y:8px]"
    />

    <!-- Intro: op mobiel bovenaan, op pc in het midden. Alleen inschuiven, niet zweven (blijft goed leesbaar). -->
    <div
        class="slide-in order-first flex w-full max-w-136 flex-col gap-3 lg:order-0"
    >
        <CodeLabel>{"<h1>"}</CodeLabel>

        <div class="flex flex-col gap-4 pl-6">
            <span class="text-4xl text-accent">Hey</span>

            <h1
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-normal lg:flex-nowrap"
            >
                <span class="text-md tracking-wider text-text">IK BEN</span>
                <span class="text-4xl font-bold text-accent sm:text-5xl">
                    Florian Koning<span class="animate-blink" aria-hidden="true"
                        >_</span
                    >
                </span>
            </h1>

            <p class="mt-1 text-lg leading-relaxed text-text-muted">
                Back-end developer bij Pay.nl, met ervaring in Laravel, Symfony
                en moderne API's.
            </p>
        </div>

        <CodeLabel>{"</h1>"}</CodeLabel>
    </div>

    <StatsCard
        class="slide-in-float from-right [--enter-delay:300ms] [--float-delay:-5s] [--float-duration:12s] [--float-r:-0.8deg] [--float-y:8px]"
    />
</div>

<ScrollHint href="#about" />
