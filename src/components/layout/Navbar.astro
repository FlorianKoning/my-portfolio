---
import { navItems, socials } from "../../data/site";
---

<header
    class="fixed inset-x-0 top-0 z-50 h-nav border-b-2 border-ink-600 bg-ink-750"
>
    <nav
        class="mx-auto flex h-full max-w-7xl items-center justify-between px-6 lg:px-8"
        aria-label="Hoofdnavigatie"
    >
        <!-- website logo -->
        <a href="#home" class="flex gap-2 text-text">
            <span>{"<?php"}</span>
            <span><span class="text-accent">Florian</span> Koning</span>
            <span>{"?>"}</span>
        </a>

        <!-- Sectie-links -->
        <ul class="hidden gap-12 md:flex">
            {
                navItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-sm font-semibold text-text transition-colors duration-300 hover:text-accent"
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Socials -->
        <ul class="hidden gap-5 lg:flex">
            {
                socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target={
                                social.href.startsWith("http")
                                    ? "_blank"
                                    : undefined
                            }
                            rel="noopener noreferrer"
                            aria-label={social.label}
                            class="text-2xl text-accent"
                        >
                            <i class={social.icon} aria-hidden="true" />
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
