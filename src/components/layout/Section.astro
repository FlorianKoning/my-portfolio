---
// Volledig uitgeschreven class-namen: Tailwind ziet geen in elkaar geplakte strings
// Wissel base en alt af. De stippellijn bovenaan elke sectie scheidt ze.
const backgrounds = {
    base: "bg-ink-700",
    alt: "bg-ink-650",
    // Zoals base, met een lichte gloed bovenin
    glow: "bg-ink-700 bg-radial-[at_50%_0%] from-ink-600 to-ink-700 to-70%",
    // Zoals alt, met dezelfde gloed bovenin
    altGlow: "bg-ink-650 bg-radial-[at_50%_0%] from-ink-600 to-ink-650 to-70%",
};

const widths = {
    // Even breed als de navbar: voor secties met veel tekst
    content: "max-w-7xl",
    // Bijna de hele schermbreedte: voor de hero
    full: "max-w-[3440px]",
};

interface Props {
    id: string;
    variant?: keyof typeof backgrounds;
    width?: keyof typeof widths;
}

const { id, variant = "base", width = "content" } = Astro.props;
---

<section
    id={id}
    class:list={[
        "relative flex min-h-svh flex-col px-5 pt-nav md:px-6",
        // Stippellijn tussen secties: niet bij de eerste, die zit al onder de navbar
        "border-ink-500 not-first:border-t",
        width === "full" ? "lg:px-[8vw]" : "lg:px-8",
        backgrounds[variant],
    ]}
>
    <div
        class:list={[
            "mx-auto flex w-full flex-1 flex-col justify-center py-12",
            widths[width],
        ]}
    >
        <slot />
    </div>
</section>
