---
interface Props {
    id: string;
}

const { id } = Astro.props;
---

<section
    id={id}
    class="relative flex min-h-svh flex-col bg-ink-700 px-6 pt-nav lg:px-8"
>
    <div
        class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center py-12"
    >
        <slot />
    </div>
</section>
