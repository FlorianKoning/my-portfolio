---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<!-- Mobiel: onderaan de hero in de flow (mt-auto duwt hem naar beneden).
     md: verborgen. lg: zwevend onderaan de sectie. -->
<a
    href={href}
    class="mt-auto flex min-h-11 w-fit flex-col items-center justify-center gap-1 self-center pt-6 text-[0.6875rem] text-text-dim transition-colors hover:text-accent md:hidden lg:absolute lg:inset-x-0 lg:bottom-8 lg:mx-auto lg:mt-0 lg:flex lg:pt-0 lg:text-sm"
>
    <span class="flex animate-nudge flex-col items-center gap-1">
        // scroll
        <span class="text-sm text-accent lg:text-xl" aria-hidden="true">↓</span>
    </span>
</a>
