---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// Een foto die je kunt aanklikken om hem groot te zien (zie Lightbox.astro).
// De knop krijgt de layout-classes (grootte, afronding, grid), de foto vult hem.
interface Props {
    src: ImageMetadata;
    alt: string;
    sizes: string;
    class?: string;
}

const { src, alt, sizes, class: className } = Astro.props;
---

<button
    type="button"
    data-zoom
    aria-label={`${alt} vergroten`}
    class:list={[
        "group relative block w-full cursor-zoom-in overflow-hidden bg-ink-800",
        className,
    ]}
>
    {/* Altijd tot 1920px breed, zodat de lightbox een scherpe versie kan kiezen */}
    <Image
        src={src}
        alt={alt}
        widths={[640, 1280, 1920]}
        sizes={sizes}
        class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
    />
</button>
