---
import { Image } from "astro:assets";
import photo from "../../assets/florian-portrait.jpeg";
import { profile } from "../../data/site";
import ProfileLocation from "./ProfileLocation.astro";
import ProfileStatus from "./ProfileStatus.astro";
import SkillList from "./SkillList.astro";

const { class: className } = Astro.props;
---

<aside
    class:list={[
        "hidden w-full max-w-80 flex-col items-center gap-5 rounded-[4.5rem_0.25rem_4.5rem_0.25rem] border border-ink-600 bg-ink-800 px-6 pt-9 pb-8 md:flex",
        className,
    ]}
>
    <Image
        src={photo}
        alt="Portret van Florian Koning"
        width={192}
        class="size-24 rounded-full border-2 border-accent object-cover object-[center_40%]"
    />

    <div class="flex flex-col gap-1 text-center">
        <span class="text-lg font-bold text-accent">{profile.name}</span>
        <span class="text-sm text-text-soft">{profile.role}</span>
    </div>

    <ProfileStatus />

    <ul class="flex w-full flex-col gap-3.5 border-t border-dashed border-ink-500 pt-5">
        <li><ProfileLocation /></li>
    </ul>

    <SkillList />
</aside>
