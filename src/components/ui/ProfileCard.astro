---
import { Image } from "astro:assets";
import photo from "../../assets/florian-portrait.jpeg";
import { profile } from "../../data/site";
import Tag from "./Tag.astro";

const { class: className } = Astro.props;
---

<aside
    class:list={[
        "hidden w-full max-w-80 flex-col items-center gap-5 rounded-[4.5rem_0.25rem_4.5rem_0.25rem] border border-ink-600 bg-ink-800 px-6 pt-9 pb-8 md:flex",
        className,
    ]}
>
    <Image
        src={photo}
        alt="Portret van Florian Koning"
        width={192}
        class="size-24 rounded-full border-2 border-accent object-cover object-[center_40%]"
    />

    <div class="flex flex-col gap-1 text-center">
        <span class="text-lg font-bold text-accent">{profile.name}</span>
        <span class="text-sm text-text-soft">{profile.role}</span>
    </div>

    <span
        class="flex items-center gap-2 rounded-full bg-ink-900 px-3 py-1 text-xs text-text-muted"
    >
        <span aria-hidden="true" class="size-2 rounded-full bg-online"></span>
        Nu bij {profile.company}
    </span>

    <ul
        class="flex w-full flex-col gap-3.5 border-t border-dashed border-ink-500 pt-5 text-[0.8125rem] text-text-soft"
    >
        <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" class="size-3 shrink-0 text-accent">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
            {profile.location}
        </li>
    </ul>

    <ul class="grid w-full grid-cols-3 gap-2" aria-label="Skills">
        {
            profile.skills.map((skill) => (
                <li class="grid">
                    <Tag label={skill} />
                </li>
            ))
        }
    </ul>
</aside>
