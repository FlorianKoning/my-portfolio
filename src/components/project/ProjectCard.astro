---
import { Image } from "astro:assets";
import { projectImages, type Project } from "../../data/projects";

// Compacte kaart op de homepage. De hele kaart is één link naar de projectpagina.
interface Props {
    project: Project;
    index: number;
}

const { project, index } = Astro.props;
const { main } = projectImages(project);
const number = String(index + 1).padStart(2, "0");
---

<a
    href={`/projecten/${project.slug}`}
    class="group flex h-full flex-col overflow-hidden rounded-[1.75rem_0.375rem_1.75rem_0.375rem] border border-ink-600 bg-ink-850 transition md:gap-5 md:overflow-visible md:rounded-[1.25rem] md:p-3 md:pb-5 duration-300 hover:border-accent focus-visible:border-accent focus-visible:outline-none motion-safe:hover:scale-[1.01] motion-safe:focus-visible:scale-[1.03]"
>
    {/* Foto: mobiel tot de rand van de kaart, vanaf md los met dezelfde schuine
        hoeken als de hoofdfoto op de projectpagina */}
    <div
        class="h-51 overflow-hidden border-b border-ink-600 bg-ink-800 md:aspect-[16/10] md:h-auto md:rounded-[0_1.25rem_0_1.25rem] md:border-b-0"
    >
        {
            /* sizes = breedte van de kaart × ~1.34: de screenshots (~2.1:1) zijn breder
               dan het 16:10-kader, dus object-cover schaalt op hoogte en tekent de foto
               breder dan de kaart. Zonder die factor kiest de browser een te kleine versie. */
        }
        <Image
            src={main}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 35rem, (min-width: 768px) 67vw, 134vw"
            class="h-full w-full object-cover object-top"
        />
    </div>

    <div class="flex flex-1 flex-col gap-2.5 px-4.5 pt-4.5 pb-5 md:gap-3 md:px-2 md:py-0">
        <p
            class="flex items-baseline justify-between gap-3 text-[0.6875rem] text-text-dim md:text-sm"
        >
            <span>
                {project.role}
                <span aria-hidden="true" class="text-ink-400">·</span>
                {project.year}
            </span>
            <span class="text-accent md:text-base md:text-inherit">{number}</span>
        </p>

        <h3
            class="text-[1.3125rem] font-bold tracking-tight transition-colors group-hover:text-accent md:-mt-1 md:text-2xl"
        >
            {project.title}
        </h3>

        {
            /* line-clamp-3: maximaal 3 regels, daarna "…". Zo blijven de kaarten even hoog */
        }
        <p class="line-clamp-3 text-[0.8125rem] leading-[1.65] text-text-subtle md:text-sm md:leading-relaxed">
            {project.intro[0]}
        </p>

        {/* mt-auto duwt de chips naar de onderkant van de kaart */}
        <div class="mt-auto flex items-center justify-between gap-2.5 pt-1">
            <ul aria-label="Stack" class="flex flex-wrap gap-1.5">
                {
                    project.stack.map((tech) => (
                        <li class="rounded-full border border-accent px-2.5 py-px text-[0.6875rem] text-accent md:py-0.5 md:text-xs">
                            {tech}
                        </li>
                    ))
                }
            </ul>
            {/* Op mobiel is er geen hover, dus een zichtbare hint dat je kunt tikken */}
            <span aria-hidden="true" class="shrink-0 text-xs text-text-soft md:hidden">
                lees <span class="text-accent">→</span>
            </span>
        </div>
    </div>
</a>
