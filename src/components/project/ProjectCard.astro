---
import { Image } from "astro:assets";
import { projectImages, type Project } from "../../data/projects";

// Compacte kaart op de homepage. De hele kaart is één link naar de projectpagina.
interface Props {
    project: Project;
    index: number;
}

const { project, index } = Astro.props;
const { main } = projectImages(project);
const number = String(index + 1).padStart(2, "0");
---

<a
    href={`/projecten/${project.slug}`}
    class="group flex h-full flex-col gap-5 rounded-[1.25rem] border border-ink-600 bg-ink-850 p-3 pb-5 transition duration-300 hover:border-accent focus-visible:border-accent focus-visible:outline-none motion-safe:hover:scale-[1.01] motion-safe:focus-visible:scale-[1.03]"
>
    {/* Foto: zelfde schuine hoeken als de hoofdfoto op de projectpagina */}
    <div
        class="aspect-[16/10] overflow-hidden rounded-[0_1.25rem_0_1.25rem] bg-ink-800"
    >
        {
            /* sizes = breedte van de kaart × ~1.34: de screenshots (~2.1:1) zijn breder
               dan het 16:10-kader, dus object-cover schaalt op hoogte en tekent de foto
               breder dan de kaart. Zonder die factor kiest de browser een te kleine versie. */
        }
        <Image
            src={main}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 35rem, (min-width: 768px) 67vw, 134vw"
            class="h-full w-full object-cover object-top"
        />
    </div>

    <div class="flex flex-1 flex-col gap-3 px-2">
        <p
            class="flex items-baseline justify-between gap-3 text-xs text-text-dim md:text-sm"
        >
            <span>
                {project.role}
                <span aria-hidden="true" class="text-ink-400">·</span>
                {project.year}
            </span>
            <span class="text-base">{number}</span>
        </p>

        <h3
            class="-mt-1 text-2xl font-bold tracking-tight transition-colors group-hover:text-accent"
        >
            {project.title}
        </h3>

        {
            /* line-clamp-3: maximaal 3 regels, daarna "…". Zo blijven de kaarten even hoog */
        }
        <p class="line-clamp-3 text-sm leading-relaxed text-text-subtle">
            {project.intro[0]}
        </p>

        {/* mt-auto duwt de chips naar de onderkant van de kaart */}
        <ul aria-label="Stack" class="mt-auto flex flex-wrap gap-1.5 pt-1">
            {
                project.stack.map((tech) => (
                    <li class="rounded-full border border-accent px-2.5 py-0.5 text-xs text-accent">
                        {tech}
                    </li>
                ))
            }
        </ul>
    </div>
</a>
